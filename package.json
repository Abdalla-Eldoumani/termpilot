{
  "name": "@termpilot/server",
  "version": "0.1.0-alpha.0",
  "description": "MCP server that drives terminal sessions like Playwright drives browsers. For testing CLIs, debuggers, REPLs, and operating systems.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "termpilot": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/index.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "inspect": "npm run build && npx -y @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run check && npm run test:run && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "canvas": "3.1.0",
    "node-pty": "1.1.0",
    "yaml": "2.6.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/node": "22.10.5",
    "shx": "0.3.4",
    "tsx": "4.20.0",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "terminal",
    "pty",
    "playwright",
    "automation",
    "ai",
    "claude",
    "testing",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-username/termpilot.git"
  },
  "homepage": "https://github.com/your-username/termpilot#readme",
  "bugs": {
    "url": "https://github.com/your-username/termpilot/issues"
  }
}
